<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo">
  <ActionBar title="{{ title }}">
    <NavigationButton text="{{ t('common.cancel') }}" android.systemIcon="ic_menu_back" tap="goBack" />
    <ActionItem ios.position="right" android.position="actionBar">
      <ActionItem.actionView>
        <Label text="{{ t('common.save') }}" tap="save" class="bar-btn" />
      </ActionItem.actionView>
    </ActionItem>
  </ActionBar>

  <ScrollView>
    <StackLayout class="form">
      <Label text="{{ t('expense.category') }}" class="field-label" />
      <ListPicker items="{{ categories }}" selectedIndex="{{ categoryIndex }}" height="120" />

      <Label text="{{ t('expense.amount') }}" class="field-label" />
      <TextField text="{{ amount }}" hint="{{ t('expense.amountHint') }}" keyboardType="number" class="input" />

      <Label text="{{ isDocument ? t('expense.datePaid') : t('expense.date') }}" class="field-label" />
      <android>
        <Label text="{{ dateText }}" tap="pickDate" class="input date-field" />
      </android>
      <ios>
        <DatePicker date="{{ date }}" height="120" />
      </ios>

      <StackLayout visibility="{{ isDocument ? 'visible' : 'collapsed' }}">
        <Label text="{{ t('expense.period') }}" class="field-label" />
        <ListPicker items="{{ periods }}" selectedIndex="{{ periodIndex }}" height="100" />

        <Label text="{{ t('expense.validUntil') }}" class="field-label" />
        <android>
          <Label text="{{ validUntilText }}" tap="pickValidUntil" class="input date-field valid-until" />
        </android>
        <ios>
          <DatePicker date="{{ validUntil }}" height="120" />
        </ios>
      </StackLayout>

      <Label text="{{ t('expense.odometer') }}" class="field-label" />
      <TextField text="{{ odometer }}" hint="{{ t('expense.optional') }}" keyboardType="number" class="input" />

      <StackLayout visibility="{{ isService ? 'visible' : 'collapsed' }}">
        <Label text="{{ t('expense.parts') }}" class="field-label" />
        <Repeater items="{{ parts }}">
          <Repeater.itemTemplate>
            <GridLayout columns="auto, *" class="{{ checked ? 'part-row part-on' : 'part-row' }}" tap="{{ toggle }}">
              <Label col="0" text="{{ checked ? '☑' : '☐' }}" class="part-box" />
              <Label col="1" text="{{ name }}" class="part-name" />
            </GridLayout>
          </Repeater.itemTemplate>
        </Repeater>
      </StackLayout>

      <StackLayout visibility="{{ isFuel ? 'visible' : 'collapsed' }}">
        <Label text="{{ t('expense.liters') }}" class="field-label" />
        <TextField text="{{ liters }}" hint="{{ t('expense.litersHint') }}" keyboardType="number" class="input" />
      </StackLayout>

      <Label text="{{ t('expense.note') }}" class="field-label" />
      <TextView text="{{ note }}" hint="{{ t('expense.noteHint') }}" class="input" />

      <Button text="{{ t('common.save') }}" tap="save" class="-primary" />
    </StackLayout>
  </ScrollView>
</Page>
