<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo">
  <ActionBar title="{{ car.name }}">
    <NavigationButton text="Назад" android.systemIcon="ic_menu_back" tap="goBack" />
    <ActionItem ios.position="right" android.position="actionBar">
      <ActionItem.actionView>
        <Label text="Опции" tap="carOptions" class="bar-btn" />
      </ActionItem.actionView>
    </ActionItem>
  </ActionBar>

  <GridLayout rows="*, auto">
    <!-- Целият екран се превърта; долните бутони остават закрепени -->
    <ScrollView row="0">
    <StackLayout>
    <!-- Обобщение -->
    <StackLayout class="summary">
      <Label text="{{ car.plate }}" class="muted" visibility="{{ car.plate ? 'visible' : 'collapsed' }}" />
      <GridLayout columns="*, *, *">
        <StackLayout col="0">
          <Label text="Общо" class="muted" />
          <Label text="{{ totalText }}" class="big" />
        </StackLayout>
        <StackLayout col="1">
          <Label text="{{ yearLabel }}" class="muted" />
          <Label text="{{ yearText }}" class="big" />
        </StackLayout>
        <StackLayout col="2">
          <Label text="Разход гориво" class="muted" />
          <Label text="{{ consumptionText }}" class="big" />
        </StackLayout>
      </GridLayout>
      <Label text="Документи" class="section-title" />
      <Repeater items="{{ docs }}">
        <Repeater.itemTemplate>
          <GridLayout columns="auto, *, auto" class="doc-row" tap="{{ open }}">
            <Label col="0" text="●" class="{{ 'svc-dot doc-' + state }}" />
            <Label col="1" text="{{ name }}" />
            <Label col="2" text="{{ text }}" class="{{ 'doc-text doc-' + state }}" />
          </GridLayout>
        </Repeater.itemTemplate>
      </Repeater>

      <Label text="По категории" class="section-title" visibility="{{ categories.length ? 'visible' : 'collapsed' }}" />
      <Repeater items="{{ categories }}">
        <Repeater.itemTemplate>
          <GridLayout columns="*, auto" class="cat-row">
            <Label col="0" text="{{ category }}" />
            <Label col="1" text="{{ totalText }}" />
          </GridLayout>
        </Repeater.itemTemplate>
      </Repeater>
    </StackLayout>

    <!-- Списък с разходи -->
    <Repeater items="{{ expenses }}">
      <Repeater.itemTemplate>
        <GridLayout columns="*, auto" class="exp-row exp-sep" tap="{{ open }}">
          <StackLayout col="0">
            <Label text="{{ category }}" class="exp-cat" />
            <Label text="{{ details }}" class="muted" textWrap="true" />
          </StackLayout>
          <Label col="1" text="{{ amountText }}" class="amount" verticalAlignment="center" />
        </GridLayout>
      </Repeater.itemTemplate>
    </Repeater>
    <Label text="Няма въведени разходи." class="muted text-center empty" visibility="{{ expenses.length ? 'collapsed' : 'visible' }}" />
    </StackLayout>
    </ScrollView>

    <GridLayout row="1" columns="*, *" class="bottom-bar">
      <Button col="0" text="{{ serviceButtonText }}" tap="openService" class="-secondary-btn" />
      <Button col="1" text="+ Разход" tap="addExpense" class="-primary" />
    </GridLayout>
  </GridLayout>
</Page>
